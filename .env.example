# AI Configuration
AI_API_KEY=your_api_key_here
AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=groq

# Database
DATABASE_URL=sqlite+aiosqlite:///./browser_automation.db

# API Security
API_AUTH_TOKEN=your_secure_random_token_here

# Allowed Domains (comma-separated for production)
ALLOWED_DOMAINS=example.com,testsite.com

# Timeouts (seconds)
BROWSER_SESSION_TIMEOUT=600
TASK_TIMEOUT=300

# Browser Settings
HEADLESS=true
BROWSER_EXECUTABLE=

# Preview Settings
PREVIEW_ENABLED=true
PREVIEW_TOKEN_SECRET=change-me-in-production

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Debug (set to false in production)
DEBUG=false

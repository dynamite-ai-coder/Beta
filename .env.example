# AI / Groq Free Tier Configuration
AI_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=groq

# Virtual AI API
BETA_API_KEY=your_beta_api_key_here
VIRTUAL_MODEL_NAME=beta-virtual-ai
MAX_AI_WORKFLOWS=1
MAX_DELIBERATION_ROUNDS=2

# Multi-agent (5 keys, different models)
GROQ_AGENT_1_API_KEY=your_groq_api_key_here
GROQ_AGENT_1_MODEL=openai/gpt-oss-120b
GROQ_AGENT_1_BASE_URL=https://api.groq.com/openai/v1
GROQ_AGENT_2_API_KEY=your_groq_api_key_here
GROQ_AGENT_2_MODEL=qwen/qwen3.6-27b
GROQ_AGENT_2_BASE_URL=https://api.groq.com/openai/v1
GROQ_AGENT_3_API_KEY=your_groq_api_key_here
GROQ_AGENT_3_MODEL=allam-2-7b
GROQ_AGENT_3_BASE_URL=https://api.groq.com/openai/v1
GROQ_AGENT_4_API_KEY=your_groq_api_key_here
GROQ_AGENT_4_MODEL=qwen/qwen3.8-27b
GROQ_AGENT_4_BASE_URL=https://api.groq.com/openai/v1
GROQ_AGENT_5_API_KEY=your_groq_api_key_here
GROQ_AGENT_5_MODEL=openai/gpt-oss-20b
GROQ_AGENT_5_BASE_URL=https://api.groq.com/openai/v1

# API Security
API_AUTH_TOKEN=your_api_auth_token_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./browser_automation.db

# Timeouts
BROWSER_SESSION_TIMEOUT=600
TASK_TIMEOUT=300

# Browser Settings
HEADLESS=true

# Proxy
PROXY_ENABLED=false
PROXY_APIKEY=
PROXY_SECRET=
PROXY_URL=

# Tor (optional anonymity layer)
USE_TOR=false
TOR_BRIDGES=

# Render API
RENDER_API_KEY=your_render_api_key_here
RENDER_SERVICE_NAME=Beta

# Client config (for running on Render)
BACKEND_URL=http://localhost:8000
LOCAL_UI_HOST=0.0.0.0
LOCAL_UI_PORT=23400
BROWSER_HEADLESS=true

# ngrok tunnel (for remote access to client UI)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

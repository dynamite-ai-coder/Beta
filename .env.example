# ============================================================
# BACKEND CONFIGURATION (Render)
# ============================================================

# AI Configuration (single key - used as fallback for all agents)
# Recommended: llama-3.3-70b-versatile (strong reasoning, free tier)
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=groq

# Virtual AI API
BETA_API_KEY=your_beta_api_key_here
VIRTUAL_MODEL_NAME=beta-virtual-ai
MAX_AI_WORKFLOWS=1
MAX_DELIBERATION_ROUNDS=2

# Multi-agent Groq configuration
# Distribute across different models to maximize throughput (rate limits are per-model)
# Free tier models: llama-3.3-70b-versatile, openai/gpt-oss-120b, openai/gpt-oss-20b,
#   qwen/qwen3-32b (60 RPM!), meta-llama/llama-4-scout-17b-16e-instruct, llama-3.1-8b-instant
GROQ_AGENT_1_API_KEY=
GROQ_AGENT_1_MODEL=llama-3.3-70b-versatile
GROQ_AGENT_2_API_KEY=
GROQ_AGENT_2_MODEL=openai/gpt-oss-120b
GROQ_AGENT_3_API_KEY=
GROQ_AGENT_3_MODEL=qwen/qwen3-32b
GROQ_AGENT_4_API_KEY=
GROQ_AGENT_4_MODEL=openai/gpt-oss-20b
GROQ_AGENT_5_API_KEY=
GROQ_AGENT_5_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Database
# SQLite (local development):
DATABASE_URL=sqlite+aiosqlite:///./browser_automation.db
# PostgreSQL (Render production):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Browser Engine: selenium | browser-use
BROWSER_ENGINE=selenium

# API Security
API_AUTH_TOKEN=your_secure_random_token_here

# Allowed Domains
ALLOWED_DOMAINS=

# Timeouts
TASK_TIMEOUT=300

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Preview
PREVIEW_ENABLED=true
PREVIEW_TOKEN_SECRET=change-me-in-production

# Debug
DEBUG=false

# ============================================================
# WINDOWS CLIENT CONFIGURATION
# ============================================================

# BACKEND_URL=http://your-render-url.onrender.com
# CLIENT_ID=windows-browser-01
# CLIENT_TOKEN=your_api_auth_token_here
# BROWSER_HEADLESS=true
# BROWSER_PROFILE_PATH=
# LOG_LEVEL=INFO
# TASK_TIMEOUT=300
